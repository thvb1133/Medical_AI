# ---------------------------------------------------------------------------
# Neura environment variables
#
# Copy to .env.local for local development, or paste each key into
# Vercel -> Project -> Settings -> Environment Variables before deploying.
#
# Nothing here is strictly required: every integration degrades to a built-in
# fallback so the app always boots. The comments say what you lose without it.
# ---------------------------------------------------------------------------

# --- Conversational model (the therapist "Fergus") -------------------------
# Provide at least one. Anthropic is preferred when both are set.
# Without either, the app runs a scripted reflective-listening fallback so the
# demo still works, but replies will not be genuinely generated.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides.
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o

# --- Speech to text --------------------------------------------------------
# Without this the browser's built-in Web Speech API is used instead, which
# works in Chrome/Edge but not Firefox and is less accurate.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- Text to speech --------------------------------------------------------
# Without this the browser's built-in speechSynthesis voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- Video avatar ----------------------------------------------------------
# Without this a lightweight animated canvas avatar is rendered locally.
ANAM_API_KEY=
ANAM_PERSONA_ID=

# --- Database --------------------------------------------------------------
# Vercel Postgres / Neon connection string. Without it, sessions are kept in
# server memory only, which is fine for a demo but will not survive a redeploy
# and is not shared between serverless instances.
DATABASE_URL=

# --- Clinician access ------------------------------------------------------
# Shared passphrase gating /clinician. Leave blank to disable the gate
# (do NOT leave blank on a public deployment).
CLINICIAN_ACCESS_CODE=

# --- Optional commercial biomarker providers -------------------------------
# The built-in in-browser biomarker pipeline is used unless these are set.
THYMIA_API_KEY=
SHEN_API_KEY=
