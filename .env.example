# ---------------------------------------------------------------------------
# Neura environment variables
#
# Copy to .env.local for local development, or paste these into
# Vercel > Project > Settings > Environment Variables for deployment.
#
# EVERY VARIABLE IS OPTIONAL. Anything you leave blank falls back to simulated
# data so the app still runs end to end. Start with AUTH_SECRET and OPENAI_API_KEY.
# ---------------------------------------------------------------------------

# --- Required in production -------------------------------------------------
# Signs the login session cookie. Generate one with: openssl rand -base64 32
# Without it, the app refuses to start in production.
AUTH_SECRET=

# --- Conversation model -----------------------------------------------------
# Without this, the agent uses a scripted reflective fallback that still
# escalates correctly on risk disclosure.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Video avatar (Anam.AI) -------------------------------------------------
# Without ANAM_API_KEY the avatar panel shows an animated presence indicator
# and the reply is spoken with the browser's own voice instead.
ANAM_API_KEY=
ANAM_PERSONA_NAME=Fergus
# Optional. Leave blank to use your Anam account's default persona.
ANAM_AVATAR_ID=
ANAM_VOICE_ID=
ANAM_LLM_ID=

# --- Realtime voice transport (Agora) ---------------------------------------
# Both are needed to mint RTC tokens. The App ID is public; the certificate
# must never be exposed to the browser, so do NOT prefix it with NEXT_PUBLIC_.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Camera vitals (Shen.AI / MX Labs) --------------------------------------
# This one IS public by design: the WASM SDK runs in the browser and reads the
# licence key directly. Without it, vitals are simulated.
NEXT_PUBLIC_SHENAI_API_KEY=

# --- Voice biomarkers (Thymia) ----------------------------------------------
# Drives the Helios (wellness) and Apollo (clinical) panels when present.
THYMIA_API_KEY=

# --- Database ---------------------------------------------------------------
# Any Postgres connection string (Neon, Supabase, Vercel Postgres, RDS).
# Tables are created automatically on first use.
# Without it, sessions live in memory and are lost when the server restarts.
DATABASE_URL=

# --- Branding ---------------------------------------------------------------
NEXT_PUBLIC_APP_TITLE=Claude Hackathon at Imperial College
NEXT_PUBLIC_APP_SUBTITLE=By Ben, Nick, Beejal, Anton, Tan

# Set to "true" to hide the biomarker rail from patients, showing it only to
# clinicians. Defaults to false so the console matches the reference design.
NEXT_PUBLIC_HIDE_PATIENT_ANALYTICS=false
